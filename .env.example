# Required
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=

# LLM 설정
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_MODEL_STRONG=llama-3.3-70b-versatile

# Groq 로테이션 키 (comma-separated, rate-limit 회피)
GROQ_API_KEYS=

# Gemini (fallback LLM)
GEMINI_API_KEY=

# Anthropic (fallback LLM)
ANTHROPIC_API_KEY=

# Hugging Face
HF_TOKEN=
HF_TOKENS=

# 검색 설정 — 3엔진 병렬 (multi), DDG 폴백 (duckduckgo)
SEARCH_PROVIDER=multi
SEARCH_MAX_ROUNDS=3
SEARCH_MAX_PAGES=10

# 검색 API 키 (무료 한도: Tavily 1000/월, Serper 2500/월, Brave 2000/월)
TAVILY_API_KEY=
SERPER_API_KEY=
SERPER_API_KEYS=
BRAVE_API_KEY=
LUNARCRUSH_API_KEY=

# Social watchlist
SOCIAL_WATCHLIST_PATH=data/curated_social_accounts.json
DISCOVERED_SOCIAL_ACCOUNTS_PATH=data/discovered_social_accounts.json
SOCIAL_REFERENCE_SEED_PATH=data/seed_raw.json
SOCIAL_VC_REGISTRY_CSV_PATH=output/spreadsheet/vc_list_final.csv
SOCIAL_WATCHLIST_LIMIT=10
SOCIAL_WATCH_TERMS_PER_ACCOUNT=3
SOCIAL_REFERENCE_WATCH_LIMIT=120
SOCIAL_ALERT_POLL_SECONDS=300
SOCIAL_ALERT_BATCH_SIZE=5

# 페이지 수집 — Jina Reader (JS 렌더링 지원)
JINA_API_KEY=

# Crypto Data APIs
COINGECKO_API_KEY=
ROOTDATA_API_KEY=
CRYPTORANK_API_KEY=

# DB
DB_PATH=data/funding.db
LOG_LEVEL=INFO
