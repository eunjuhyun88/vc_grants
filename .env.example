# Required
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=

# LLM 설정 (groq 기본, anthropic 폴백)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant

# 검색 설정 (duckduckgo 기본, tavily 폴백)
SEARCH_PROVIDER=duckduckgo

# Optional (폴백용)
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# DB
DB_PATH=data/funding.db
LOG_LEVEL=INFO
